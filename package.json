{
  "name": "sera-ai",
  "version": "1.0.22",
  "description": "React component for real-time audio recording with AI transcription - works out of the box with embedded workers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test:dev": "cd test && vite",
    "test:build": "cd test && vite build",
    "prepublishOnly": "npm run build",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "keywords": [
    "react",
    "audio",
    "recording",
    "transcription",
    "ai",
    "speech-to-text",
    "voice",
    "microphone",
    "web-audio",
    "real-time",
    "embedded-workers",
    "self-contained"
  ],
  "author": "Nuxera AI",
  "license": "ISC",
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "lucide-react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.11.0",
    "@ffmpeg/ffmpeg": "^0.11.0",
    "@ffmpeg/util": "^0.12.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "lucide-react": "^0.562.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuxera-AI-Team/sera-ai.git"
  },
  "bugs": {
    "url": "https://github.com/Nuxera-AI-Team/sera-ai/issues"
  },
  "homepage": "https://github.com/Nuxera-AI-Team/sera-ai#readme",
  "dependencies": {
    "p-retry": "^7.1.1"
  },
  "sideEffects": false
}
